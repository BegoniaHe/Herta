{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/ipc/bridge-types.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.dom-free.ts",
    "src/vitest-dom-free.test.ts"
  ]
}
